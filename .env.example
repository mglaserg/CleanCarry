# CleanCarry defaults to read-only/shadow. Live requires an API wallet plus persistent arming.
HL_BASE_URL=https://api.hyperliquid.xyz
HL_ACCOUNT_ADDRESS=
# Use an authorized Hyperliquid API wallet key, never the main withdrawal-capable wallet key.
HL_API_WALLET_PRIVATE_KEY=
# Recommended: dedicate a subaccount to CleanCarry. Leave empty only for a dedicated main account.
HL_SUBACCOUNT_ADDRESS=

CLEANCARRY_DATA_DIR=/opt/cleancarry/data
CLEANCARRY_STATE_DIR=/opt/cleancarry/state
CLEANCARRY_LOG_DIR=/opt/cleancarry/logs

# Scanner gates. Treat these as initial operating values, not research conclusions.
CC_MIN_SPOT_DAY_VOLUME_USD=50000000
CC_MIN_PERP_DAY_VOLUME_USD=50000000
CC_MIN_PERP_OPEN_INTEREST_USD=0
CC_MIN_DEPTH_USD_PER_LEG=10000
CC_DEPTH_IMPACT_BPS=20
CC_MIN_NET_APR=0.30
CC_EXIT_NET_APR=0.10
CC_MAX_ABS_BASIS_BPS=300
CC_MAX_SPREAD_BPS_PER_LEG=35
CC_EXPECTED_HOLD_HOURS=168
CC_ROUND_TRIP_FEES_BPS=20
CC_BASIS_RISK_BUFFER_APR=0.02
CC_HISTORY_HOURS=168
CC_FUNDING_FORECAST_METHOD=rw_mean_96h
CC_FUNDING_MEAN_HOURS=96
CC_VOLUME_LOOKBACK_DAYS=5
CC_MIN_FUNDING_HISTORY=96
CC_HISTORY_CANDIDATES=1000
CC_BOOK_CANDIDATES=1000
# HyperCore may use L1 token names different from UI/perp tickers (e.g. UBTC -> BTC).
CC_SPOT_TO_PERP_ALIASES=UBTC:BTC

# Autonomous decision and shadow-portfolio controls.
CC_EXECUTION_MODE=read_only
CC_UNIVERSE_REFRESH_SECONDS=3600
CC_STRATEGY_CYCLE_SECONDS=300
CC_STALE_DATA_SECONDS=120
CC_ORDER_TIMEOUT_SECONDS=30
CC_ALLOWLIST=
CC_DENYLIST=
CC_STRATEGY_CAPITAL_USD=10000
CC_MAX_POSITIONS=20
CC_MAX_TOTAL_DEPLOYMENT_USD=10000
CC_MAX_PER_ASSET_USD=2500
CC_PERP_MARGIN_FRACTION=0.20
CC_MAX_MARGIN_UTILIZATION=0.50
CC_LIQUIDITY_PARTICIPATION=0.01
CC_HEDGE_TOLERANCE_BPS=50
CC_TRADE_BUFFER_USD=25
CC_TRADE_BUFFER_FRACTION=0.03

# First live gate; persistent `live-control arm` is independently required.
LIVE_TRADING_ENABLED=false
CC_LIVE_MAX_ORDER_USD=100
CC_LIVE_MAX_TOTAL_DEPLOYMENT_USD=1000
CC_LIVE_MIN_ORDER_USD=10
# Operator choice: 25% is a CleanCarry safety default, not a RobotWealth parameter.
CC_LIVE_CAPITAL_FRACTION=0.25
CC_LIVE_SLIPPAGE_BPS=20
