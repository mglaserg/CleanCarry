[Unit]
Description=CleanCarry Hyperliquid account snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cleancarry
Group=cleancarry
WorkingDirectory=/opt/cleancarry
EnvironmentFile=/opt/cleancarry/.env
Environment=HOME=/opt/cleancarry
Environment=UV_CACHE_DIR=/opt/cleancarry/.cache/uv
ExecStart=/usr/local/bin/uv run --project /opt/cleancarry --frozen --no-sync cleancarry status
StandardOutput=append:/opt/cleancarry/logs/account.log
StandardError=append:/opt/cleancarry/logs/account.err.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/cleancarry/data /opt/cleancarry/logs /opt/cleancarry/state /opt/cleancarry/.cache/uv
