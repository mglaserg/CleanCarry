[Unit]
Description=CleanCarry autonomous shadow strategy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cleancarry
Group=cleancarry
WorkingDirectory=/opt/cleancarry
EnvironmentFile=/opt/cleancarry/.env
ExecStart=/opt/cleancarry/.venv/bin/cleancarry autonomous --mode shadow
Restart=on-failure
RestartSec=15
StandardOutput=append:/opt/cleancarry/logs/autonomous.log
StandardError=append:/opt/cleancarry/logs/autonomous.err.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/cleancarry/data /opt/cleancarry/logs /opt/cleancarry/state

[Install]
WantedBy=multi-user.target
